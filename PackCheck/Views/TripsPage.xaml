<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:PackCheck.Models"
    xmlns:interfaces="clr-namespace:PackCheck.ViewModels.Interfaces"
    x:Class="PackCheck.Views.TripsPage"
    x:DataType="interfaces:ITripsViewModel"
    Title="My trips">

    <Grid Padding="24"
          RowDefinitions="Auto,*"
          RowSpacing="20">

        <VerticalStackLayout Spacing="4">
            <Label Text="My trips"
                   FontSize="30"
                   FontAttributes="Bold" />

            <Label Text="Get ready for your next adventure."
                   FontSize="14" />
        </VerticalStackLayout>

        <CollectionView
            Grid.Row="1"
            ItemsSource="{Binding Trips}"
            SelectionMode="None"
            EmptyView="You haven't added any trips yet.">

            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical"
                                   ItemSpacing="12" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Trip">

                    <Border Padding="16"
                            Stroke="#D0D5DD"
                            StrokeThickness="1">

                        <VerticalStackLayout Spacing="6">
                            <Label Text="{Binding Name}"
                                   FontSize="20"
                                   FontAttributes="Bold" />

                            <Label Text="{Binding TripType}"
                                   FontSize="14" />

                            <Label
                                Text="{Binding DepartureDate,
                                    StringFormat='Departure: {0:dd/MM/yyyy}'}"
                                FontSize="14" />
                        </VerticalStackLayout>

                    </Border>

                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>
    </Grid>

</ContentPage>